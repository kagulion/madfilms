---
const today = new Date();
import "../styles/global.css";
import {
  SITE_TITLE,
  SITE_FULL_TITLE,
  SITE_ABOUT,
  TELEGRAM_LINK,
} from "../consts";
---

<footer class="m-0 px-4 py-4 bg-stone-900">
  <div class="mx-auto flex flex-col gap-2 md:max-w-5xl">
		<p class="font-medium text-xs text-stone-50">{SITE_ABOUT}</p>
		<div class="w-full h-px bg-stone-700"></div>
		<div class="flex justify-between items-center">
			<p class="font-medium text-xs text-stone-50">
				{SITE_FULL_TITLE}, {today.getFullYear()}
			</p>
			<a
				href={TELEGRAM_LINK}
				target="_blank"
				aria-label="Maddyson Films в Telegram"
			>
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
