---
const today = new Date();
import "../styles/global.css";
import {
  SITE_VERSION,
  SITE_FULL_TITLE,
  SITE_ABOUT,
  TELEGRAM_LINK,
} from "../consts";
---

<div class="relative z-0 flex justify-center -mb-8 pointer-events-none">
  <img src="/vault-boy.png" alt="Vault Boy" class="select-none pointer-events-auto" />
</div>
<footer class="relative z-10 m-0 px-4 py-3 bg-stone-200 mt-auto">
  <div class="mx-auto flex flex-col gap-2 md:max-w-5xl">
    <p class="font-semibold text-xs text-stone-950">{SITE_ABOUT}</p>
    <div class="w-full h-px bg-stone-300"></div>
    <div class="flex justify-between items-center">
      <p class="font-semibold text-xs text-stone-950">
        {SITE_FULL_TITLE}, {SITE_VERSION} // {today.getFullYear()}
      </p>
      <a
        href={TELEGRAM_LINK}
        target="_blank"
        aria-label="Maddyson Films в Telegram"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 28 28"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M3.96683 3.96671C2.3335 5.61559 2.3335 8.25226 2.3335 13.5334V14.4667C2.3335 19.74 2.3335 22.3767 3.96683 24.0334C5.61571 25.6667 8.25238 25.6667 13.5335 25.6667H14.4668C19.7402 25.6667 22.3768 25.6667 24.0335 24.0334C25.6668 22.3845 25.6668 19.7479 25.6668 14.4667V13.5334C25.6668 8.26004 25.6668 5.62337 24.0335 3.96671C22.3846 2.33337 19.748 2.33337 14.4668 2.33337H13.5335C8.26016 2.33337 5.6235 2.33337 3.96683 3.96671ZM6.26905 9.43449C6.3935 15.5012 9.42683 19.1412 14.7468 19.1412H15.058V15.6722C17.0102 15.8667 18.488 17.2979 19.079 19.1412H21.8402C21.557 18.0938 21.0549 17.1182 20.3671 16.2789C19.6794 15.4397 18.8215 14.7558 17.8502 14.2722C18.7206 13.7422 19.4724 13.0382 20.0585 12.2045C20.6447 11.3708 21.0527 10.4252 21.2568 9.42671H18.7523C18.208 11.3556 16.5902 13.1056 15.058 13.2689V9.43449H12.5457V16.1545C10.9902 15.7656 9.03016 13.8834 8.9446 9.43449H6.26905Z"
            fill="#1E1E1E"></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
