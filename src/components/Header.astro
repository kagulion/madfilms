<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const randomFilmBtn = document.getElementById('random-film-btn');

    if (randomFilmBtn) {
      randomFilmBtn.addEventListener('click', async (e) => {
        e.preventDefault();

        try {
          const response = await fetch('/api/random-film');
          if (!response.ok) {
            throw new Error('Failed to fetch random film');
          }

          const data = await response.json();
          if (data.slug) {
            window.location.href = `/${data.slug}/`;
          }
        } catch (error) {
          console.error('Error fetching random film:', error);
          // Fallback на главную страницу при ошибке
          window.location.href = '/';
        }
      });
    }
  });
</script>
