---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  link,
  tgLink,
  vkLink,
  rutubeLink,
  youtubeLink,
  iframe,
  heroImage,
  movieYear,
} = Astro.props;
---

<html lang="ru">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />
    <main class="m-0 py-5 px-4">
      <article
        class="mx-auto px-5 pt-4 pb-5 mb-12 rounded-xl bg-stone-800 md:max-w-5xl lg:px-6 lg:py-5"
      >
        <div class="flex flex-col gap-4 lg:gap-5">
          <div class="flex flex-col gap-2">
            <h1 class="font-semibold text-xl text-white lg:text-2xl">
              Мэддисон смотрит «{title}»
            </h1>
            <span class="text-lg text-lime-400">
              {movieYear}
            </span>
          </div>
          {iframe && <div set:html={iframe} />}
          <div class="flex flex-col gap-3">
            <h4 class="font-semibold text-lg text-white lg:text-xl">
              Резервные ссылки
            </h4>
            <div class="flex gap-3">
              {
                tgLink && (
                  <a
                    href={tgLink}
                    target="_blank"
                    class="inline-block w-fit h-fit px-3 pt-1.5 pb-2 rounded-lg text-sm font-semibold bg-lime-400 text-stone-950 lg:text-base lg:px-4 lg:pt-2 lg:pb-3 hover:shadow-sm hover:shadow-lime-400 lg:hover:shadow-md transition-all duration-300"
                  >
                    Telegram
                  </a>
                )
              }
              {
                vkLink && (
                  <a
                    href={vkLink}
                    target="_blank"
                    class="inline-block w-fit h-fit px-3 pt-1.5 pb-2 rounded-lg text-sm font-semibold bg-lime-400 text-stone-950 lg:text-base lg:px-4 lg:pt-2 lg:pb-3 hover:shadow-sm hover:shadow-lime-400 lg:hover:shadow-md transition-all duration-300"
                  >
                    Вконтакте
                  </a>
                )
              }
              {
                rutubeLink && (
                  <a
                    href={rutubeLink}
                    target="_blank"
                    class="inline-block w-fit h-fit px-3 pt-1.5 pb-2 rounded-lg text-sm font-semibold bg-lime-400 text-stone-950 lg:text-base lg:px-4 lg:pt-2 lg:pb-3 hover:shadow-sm hover:shadow-lime-400 lg:hover:shadow-md transition-all duration-300"
                  >
                    Rutube
                  </a>
                )
              }
              {
                youtubeLink && (
                  <a
                    href={youtubeLink}
                    target="_blank"
                    class="inline-block w-fit h-fit px-3 pt-1.5 pb-2 rounded-lg text-sm font-semibold bg-lime-400 text-stone-950 lg:text-base lg:px-4 lg:pt-2 lg:pb-3 hover:shadow-sm hover:shadow-lime-400 lg:hover:shadow-md transition-all duration-300"
                  >
                    Youtube
                  </a>
                )
              }
            </div>
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
