---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  link,
  tgLink,
  vkLink,
  iframe,
  heroImage,
  movieYear,
} = Astro.props;
---

<html lang="ru">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />
    <main
      class="min-h-screen m-0 p-5 bg-stone-100 bg-[url('/dust-texture.png')] bg-repeat"
    >
      <article class="mx-auto p-5 border border-dashed md:max-w-5xl lg:p-6">
        <div class="flex flex-col gap-5 lg:gap-6">
          <div class="flex flex-col gap-2">
            <h1 class="uppercase font-bold text-2xl text-stone-950">
              Мэддисон смотрит «{title}»
            </h1>
            <span class="text-xl text-stone-500">
              {movieYear}
            </span>
          </div>
          {iframe && <div set:html={iframe} />}
          <div class="flex flex-col gap-3">
            <h4 class="font-semibold text-xl text-stone-950">
              Резервные ссылки
            </h4>
            <div class="flex gap-3">
              {
                tgLink && (
                  <a
                    href={tgLink}
                    target="_blank"
                    class="inline-block w-fit h-fit px-5 py-3 text-base font-semibold bg-yellow-400 text-stone-950 hover:border-b-2 hover:shadow-sm hover:shadow-yellow-400 transition-all duration-100"
                  >
                    Telegram
                  </a>
                )
              }
              {
                vkLink && (
                  <a
                    href={vkLink}
                    target="_blank"
                    class="inline-block w-fit h-fit px-5 py-3 text-base font-semibold bg-yellow-400 text-stone-950 hover:border-b-2 hover:shadow-sm hover:shadow-yellow-400 transition-all duration-100"
                  >
                    Вконтакте
                  </a>
                )
              }
            </div>
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
