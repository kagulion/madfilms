---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import homeCards from "../data/homeCards.json";

type HomeCard = {
  slug: string;
  title: string;
  movieYear: number;
  heroImage: string;
  link: string;
};

const cards = homeCards as HomeCard[];
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main
      class="m-0 h-screen px-4 py-4 bg-stone-100 bg-[url('/dust-texture.png')] bg-repeat"
    >
      <section class="mx-auto md:max-w-5xl">
        <ul
          class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 lg:gap-5"
        >
          {
            cards.map((card) => (
              <li class="p-3 border border-dashed lg:p-4">
                <a
                  href={`/films/${card.slug}/`}
                  class="group flex flex-col gap-1"
                >
                  <img
                    class="h-52 object-cover lg:h-56 w-full"
                    src={card.heroImage}
                    alt="Постер фильма"
                    loading="lazy"
                  />
                  <p class="text-xs text-stone-500 lg:text-sm">
                    {card.movieYear}
                  </p>
                  <h4 class="font-bold uppercase text-base text-stone-950 lg:text-lg/6 group-hover:last:text-yellow-500 transition-colors duration-300">
                    {card.title}
                  </h4>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
