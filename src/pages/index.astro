---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import homeCards from "../data/homeCards.json";

type HomeCard = {
  slug: string;
  title: string;
  movieYear: number;
  heroImage: string;
  link: string;
};

const cards = homeCards as HomeCard[];
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main
      class="m-0 px-4 pt-4 bg-stone-100 bg-[url('/dust-texture.png')] bg-repeat"
    >
      <section class="mx-auto mb-5 max-w-480">
        <ul
          class="grid grid-cols-2 gap-4 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 2xl:grid-cols-10 lg:gap-5"
        >
          {
            cards.map((card) => (
              <li class="p-3 border border-dashed lg:p-4">
                <a
                  href={card.link}
                  target="_blank"
                  class="group flex flex-col gap-1"
                >
                  <img
                    class="h-52 object-cover md:h-36 lg:h-40 xl:h-44 2xl:h-52 w-full"
                    src={card.heroImage}
                    alt="Постер фильма"
                    loading="lazy"
                  />
                  <p class="text-xs text-stone-500 lg:text-sm">
                    {card.movieYear}
                  </p>
                  <h4 class="truncate font-bold uppercase text-base text-stone-950 lg:text-lg/6 group-hover:last:text-yellow-500 transition-colors duration-300">
                    {card.title}
                  </h4>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <div class="flex justify-center">
        <img src="/vault-boy.png" alt="Vault Boy">
      </div>
    </main>
    <Footer />
  </body>
</html>
