---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import collections from "../../data/collections.json";

type Collection = {
  slug: string;
  title: string;
  heroImage: string;
};

const collectionsList = collections as Collection[];
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead title={`Коллекции — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="m-0 px-4 pt-4">
      <section class="mx-auto mb-5 max-w-480">
        <h1
          class="mx-auto max-w-5xl mb-4 font-semibold text-xl text-white sm:mb-6 sm:text-2xl"
        >
          Коллекции
        </h1>
        <ul
          class="grid grid-cols-2 gap-4 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 2xl:grid-cols-10 lg:gap-5"
        >
          {
            collectionsList.map((collection) => (
              <li class="p-2 pb-4 rounded-xl bg-stone-800">
                <a href={`/collections/${collection.slug}/`} class="group flex flex-col gap-2">
                  <img
                    class="h-52 object-cover rounded-lg lg:h-56 group-hover:scale-103 transition-transform duration-300"
                    src={collection.heroImage}
                    alt={`Постер коллекции ${collection.title}`}
                    loading="lazy"
                  />
                  <div class="flex flex-col px-2 gap-1">
                    <h4 class="font-bold uppercase leading-5 text-white lg:text-lg group-hover:text-lime-400 transition-colors duration-300">
                      {collection.title}
                    </h4>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <div class="flex justify-center">
        <img src="/vault-boy.png" alt="Vault Boy" />
      </div>
    </main>
    <Footer />
  </body>
</html>
