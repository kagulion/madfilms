---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import homeCards from "../../data/homeCards.json";

type HomeCard = {
  slug: string;
  title: string;
  movieYear: number;
  heroImage: string;
  link: string;
};

const cards = homeCards as HomeCard[];
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="m-0 px-4 pt-4">
      <section class="mx-auto mb-5 max-w-480">
        <h1
          class="mx-auto max-w-5xl mb-4 font-semibold text-xl text-white sm:mb-6 sm:text-2xl"
        >
          Все фильмы с комментариями Ильи Мэддисона ссылками в Telegram
        </h1>
        <ul
          class="grid grid-cols-2 gap-4 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 2xl:grid-cols-10 lg:gap-5"
        >
          {
            cards.map((card) => (
              <li class="group/card relative p-2 pb-4 rounded-xl bg-stone-800">
                <svg
                  class="absolute right-3 top-3 w-7 h-7 opacity-20 transition-opacity duration-300 group-hover/card:opacity-100 z-10"
                  width="28"
                  height="28"
                  viewBox="0 0 28 28"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M18.7699 9.31705C18.7745 9.31705 18.7807 9.31705 18.7869 9.31705C18.9488 9.31705 19.0991 9.3674 19.2223 9.45416L19.22 9.45261C19.3098 9.53086 19.3702 9.64086 19.385 9.76481V9.76713C19.4005 9.86165 19.409 9.9701 19.409 10.0809C19.409 10.1312 19.4074 10.1808 19.4036 10.2304V10.2234C19.2292 12.0586 18.4732 16.5092 18.0889 18.5636C17.9262 19.4336 17.6063 19.7249 17.2964 19.7527C16.6232 19.8155 16.1119 19.3081 15.4597 18.8805C14.4386 18.2104 13.8615 17.7936 12.8707 17.1405C11.7249 16.3868 12.4678 15.9708 13.1201 15.2937C13.2913 15.1155 16.2591 12.4158 16.3172 12.171C16.3203 12.1562 16.3219 12.14 16.3219 12.1229C16.3219 12.0625 16.2994 12.0075 16.263 11.9657C16.2227 11.9393 16.1724 11.9246 16.1197 11.9246C16.0848 11.9246 16.0515 11.9316 16.0205 11.9432L16.0221 11.9424C15.9198 11.9657 14.2889 13.0435 11.1292 15.1759C10.7845 15.4479 10.3491 15.6198 9.875 15.64H9.87035C9.1987 15.5586 8.58903 15.4091 8.01034 15.1961L8.06767 15.2147C7.34102 14.9776 6.76389 14.8529 6.81347 14.4516C6.8398 14.243 7.12747 14.0294 7.67646 13.811C11.0582 12.3375 13.3133 11.3663 14.4417 10.8974C15.6866 10.2366 17.1299 9.69276 18.6475 9.34029L18.7691 9.31627L18.7699 9.31705ZM13.9731 2.33331C7.54166 2.34881 2.3335 7.56627 2.3335 14C2.3335 20.443 7.55638 25.6666 14.0002 25.6666C20.4439 25.6666 25.6668 20.4438 25.6668 14C25.6668 7.56627 20.4587 2.34881 14.0288 2.33331H14.0273C14.0092 2.33331 13.9911 2.33331 13.9731 2.33331Z"
                    fill="#FDC700"
                  />
                </svg>
                <a
                  href={card.link}
                  target="_blank"
                  class="group flex flex-col gap-2"
                >
                  <img
                    class="h-52 object-cover rounded-lg lg:h-56 group-hover:scale-103 transition-transform duration-300"
                    src={card.heroImage}
                    alt="Постер фильма"
                    loading="lazy"
                  />
                  <p class="text-xs text-yellow-400 lg:text-sm">
                    {card.movieYear}
                  </p>
                  <h4 class="font-bold uppercase leading-5 text-white lg:text-lg group-hover:text-yellow-400 transition-colors duration-300">
                    {card.title}
                  </h4>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
